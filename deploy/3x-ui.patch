new file mode 100644
index 0000000..b715f5b
--- /dev/null
+++ b/extensions/masiha-vpn/worker.py
@@ -0,0 +1,39 @@
+#!/usr/bin/python3
+import hashlib, subprocess, time
+from pathlib import Path
+from manager import BASE, db, expire
+import fcntl
+
+def ensure(args):
+    check=args.copy()
+    check[check.index("-A")]="-C"
+    if subprocess.run(check,capture_output=True).returncode:
+        subprocess.run(args,check=True)
+def network():
+    subprocess.run(["sysctl","-w","net.ipv4.ip_forward=1"],check=True)
+    for iface,subnet in [("tun-masiha","10.81.0.0/24"),("vpns+","10.82.0.0/24")]:
+        ensure(["iptables","-w","-t","nat","-A","POSTROUTING","-s",subnet,"-o","eth0","-j","MASQUERADE"])
+        ensure(["iptables","-w","-A","FORWARD","-i",iface,"-s",subnet,"-o","eth0","-j","ACCEPT"])
+        ensure(["iptables","-w","-A","FORWARD","-i","eth0","-o",iface,"-d",subnet,"-m","conntrack","--ctstate","RELATED,ESTABLISHED","-j","ACCEPT"])
+def main():
+    BASE.mkdir(mode=0o700,parents=True,exist_ok=True)
+    network()
+    cert=Path("/etc/letsencrypt/live/xu.chanelchat.ir/fullchain.pem")
+    last=hashlib.sha256(cert.read_bytes()).digest()
+    sales_process = None
+    while True:
+        try:
+            if sales_process is None or sales_process.poll() is not None:
+                sales_process = subprocess.Popen(["/usr/bin/python3", "/opt/masiha-vpn-extension/sales_worker.py"])
+            with open(BASE/"manager.lock","a") as lock:
+                fcntl.flock(lock,fcntl.LOCK_EX)
+                with db() as c: expire(c)
+            current=hashlib.sha256(cert.read_bytes()).digest()
+            if current!=last:
+                subprocess.run(["ocserv","-t","-c","/etc/ocserv/ocserv.conf"],check=True)
+                subprocess.run(["systemctl","reload","ocserv"],check=True)
+                last=current
+        except Exception as e:
+            print("Reconciliation error:",str(e),flush=True)
+        time.sleep(15)
+if __name__=="__main__": main()
