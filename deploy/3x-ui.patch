+import {fireEvent,screen,waitFor} from '@testing-library/react';
+import {afterEach,expect,test,vi} from 'vitest';
+import {App} from 'antd';
+import SalesBotPage from '@/pages/vpn/SalesBotPage';
+import {renderWithProviders} from './test-utils';
+afterEach(()=>vi.unstubAllGlobals());
+test('sales settings send JSON and numeric admin IDs without disclosing stored token',async()=>{
+ vi.restoreAllMocks();
+ const calls:any[]=[];
+ vi.stubGlobal('fetch',vi.fn(async(url:string,opts:RequestInit={})=>{
+  if(String(url).endsWith('/csrf-token'))return new Response(JSON.stringify({success:true,obj:'test-token'}),{status:200});
+  const body=JSON.parse(String(opts.body));calls.push({body,contentType:new Headers(opts.headers).get('Content-Type')});
+  const obj=body.action==='inbounds'?[]:body.action==='get'?{settings:{admins:[123456],enabled:false,token_set:true},runtime:{},plans:[],users:[],orders:[],topups:[],coupons:[],tickets:[],ledger:[],revenue:0}:true;
+  return new Response(JSON.stringify({success:true,obj}),{status:200,headers:{'Content-Type':'application/json'}});
+ }));
+ renderWithProviders(<App><SalesBotPage/></App>);
+ await screen.findByDisplayValue('123456');
+ expect(screen.queryByDisplayValue('secret-token')).toBeNull();
+ fireEvent.click(screen.getByText('ذخیره تنظیمات'));
+ await waitFor(()=>expect(calls.some(c=>c.body.action==='settings')).toBe(true));
+ const save=calls.find(c=>c.body.action==='settings');
+ expect(save.contentType).toBe('application/json');
+ expect(save.body.values.admins).toEqual([123456]);
+});
