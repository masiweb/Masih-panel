diff --git a/internal/web/controller/masiha_reconcile.go b/internal/web/controller/masiha_reconcile.go
new file mode 100644
index 0000000..fae8c7e
--- /dev/null
+++ b/internal/web/controller/masiha_reconcile.go
@@ -0,0 +1,36 @@
+package controller
+
+import (
+	"github.com/gin-gonic/gin"
+	"github.com/mhsanaei/3x-ui/v3/internal/database"
+	"github.com/mhsanaei/3x-ui/v3/internal/web/service"
+	"github.com/mhsanaei/3x-ui/v3/internal/xray"
+)
+
+// Runs native delayed-start, quota and expiration maintenance for external VPN
+// usage already atomically credited by the local adapter. Never adds bytes twice.
+func masihaReconcile(c *gin.Context) {
+	var emails []string
+	err := database.GetDB().Table("clients AS c").
+		Joins("JOIN masiha_accounts a ON a.client_id = c.id AND a.generation = c.created_at").
+		Joins("JOIN client_traffics t ON t.email = c.email").
+		Where("t.last_online > 0").Pluck("c.email", &emails).Error
+	if err != nil {
+		jsonObj(c, nil, err)
+		return
+	}
+	samples := make([]*xray.ClientTraffic, 0, len(emails))
+	for _, email := range emails {
+		samples = append(samples, &xray.ClientTraffic{Email: email})
+	}
+	svc := service.InboundService{}
+	restart, disabled, err := svc.AddTraffic(nil, samples)
+	if restart {
+		x := service.XrayService{}
+		x.SetToNeedRestart()
+	}
+	if disabled {
+		notifyClientsChanged()
+	}
+	jsonObj(c, true, err)
+}
