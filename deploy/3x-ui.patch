+import { fireEvent, screen, waitFor } from '@testing-library/react';
+import { afterEach, expect, test, vi } from 'vitest';
+import { App } from 'antd';
+import VPNPage from '@/pages/vpn/VPNPage';
+import { renderWithProviders } from './test-utils';
+
+afterEach(()=>vi.unstubAllGlobals());
+
+test('VPN UI sends JSON through the real HTTP utility and renders returned users',async()=>{
+ vi.restoreAllMocks();
+ const calls: { url:string; body:Record<string,unknown>; contentType:string }[]=[];
+ vi.stubGlobal('fetch',vi.fn(async(url:string,opts:RequestInit={})=>{
+  if(String(url).endsWith('/csrf-token'))return new Response(JSON.stringify({success:true,obj:'test-token'}),{status:200});
+  const headers=new Headers(opts.headers);
+  const body=JSON.parse(String(opts.body));
+  calls.push({url:String(url),body,contentType:headers.get('Content-Type')||''});
+  return new Response(JSON.stringify({success:true,obj:{users:[{username:'demo-vpn',enabled:true,expired:false,expires:0,created:1}],status:{service:'active',endpoint:'xu.chanelchat.ir:1194',online:[]}}}),{status:200,headers:{'Content-Type':'application/json'}});
+ }));
+ renderWithProviders(<App><VPNPage protocol="openvpn"/></App>);
+ await screen.findByText('demo-vpn');
+ expect(calls[0].body).toEqual({protocol:'openvpn',action:'list'});
+ expect(calls[0].contentType).toBe('application/json');
