index 0000000..33eca19
--- /dev/null
+++ b/internal/sub/masiha_profiles.go
@@ -0,0 +1,65 @@
+package sub
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"github.com/gin-gonic/gin"
+	"net/http"
+	"os/exec"
+	"strconv"
+	"time"
+)
+
+var masihaProfileSlots = make(chan struct{}, 4)
+
+type masihaProfile struct {
+	Protocol string `json:"protocol"`
+	ClientID int    `json:"clientId"`
+	Label    string `json:"label"`
+	Filename string `json:"filename"`
+	Content  string `json:"content"`
+	Expires  int64  `json:"expires"`
+}
+
+func (a *SUBController) masihaProfiles(c *gin.Context) {
+	c.Header("Cache-Control", "no-store, private")
+	c.Header("Referrer-Policy", "no-referrer")
+	c.Header("X-Content-Type-Options", "nosniff")
+	if _, ok := a.buildSubPageData(c); !ok {
+		return
+	}
+	select {
+	case masihaProfileSlots <- struct{}{}:
+		defer func() { <-masihaProfileSlots }()
+	default:
+		c.Status(http.StatusTooManyRequests)
+		return
+	}
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 15*time.Second)
+	defer cancel()
+	input, _ := json.Marshal(map[string]string{"subId": c.Param("subid")})
+	cmd := exec.CommandContext(ctx, "/usr/bin/python3", "/opt/masiha-vpn-extension/unified.py")
+	cmd.Stdin = bytes.NewReader(input)
+	out, err := cmd.Output()
+	var result struct {
+		Success bool            `json:"success"`
+		Obj     []masihaProfile `json:"obj"`
+	}
+	if err != nil || json.Unmarshal(out, &result) != nil || !result.Success {
+		c.Status(http.StatusServiceUnavailable)
+		return
+	}
+	if c.Param("protocol") != "" {
+		for _, p := range result.Obj {
+			if p.Protocol == c.Param("protocol") && strconv.Itoa(p.ClientID) == c.Param("client") {
+				c.Header("Content-Disposition", `attachment; filename="`+p.Filename+`"`)
+				c.Data(http.StatusOK, "application/octet-stream", []byte(p.Content))
+				return
+			}
+		}
+		c.Status(http.StatusNotFound)
+		return
+	}
+	c.JSON(http.StatusOK, result.Obj)
+}
