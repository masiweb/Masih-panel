@@ -0,0 +1,75 @@
+package controller
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"github.com/gin-gonic/gin"
+	"net/http"
+	"os/exec"
+	"time"
+)
+
+func masihaSales(c *gin.Context) {
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 65536)
+	body, err := c.GetRawData()
+	if err != nil || !json.Valid(body) {
+		c.JSON(400, gin.H{"success": false, "msg": "Invalid request"})
+		return
+	}
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 60*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "/usr/bin/python3", "/opt/masiha-vpn-extension/sales.py")
+	cmd.Stdin = bytes.NewReader(body)
+	out, err := cmd.Output()
+	if err != nil || !json.Valid(out) {
+		c.JSON(500, gin.H{"success": false, "msg": "Sales operation failed"})
+		return
+	}
+	c.Header("Cache-Control", "no-store")
+	c.Data(200, "application/json; charset=utf-8", out)
+}
+
+var salesPaymentSlots = make(chan struct{}, 4)
+
+// This public return endpoint accepts only a gateway authority. It never trusts
+// a browser-provided amount, user ID, status or request action for crediting.
+func MasihaPaymentReturn(c *gin.Context) {
+	if c.Query("Status") != "OK" {
+		c.String(200, "پرداخت لغو شد یا کامل نشد. به ربات برگردید.")
+		return
+	}
+	authority := c.Query("Authority")
+	if len(authority) < 10 || len(authority) > 100 {
+		c.String(400, "شناسه نامعتبر")
+		return
+	}
+	select {
+	case salesPaymentSlots <- struct{}{}:
+		defer func() { <-salesPaymentSlots }()
+	default:
+		c.String(429, "کمی بعد دوباره تلاش کنید")
+		return
+	}
+	body, _ := json.Marshal(map[string]string{"authority": authority})
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 30*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "/usr/bin/python3", "/opt/masiha-vpn-extension/sales.py", "payment")
+	cmd.Stdin = bytes.NewReader(body)
+	out, err := cmd.Output()
+	var r struct {
+		Success bool   `json:"success"`
+		Obj     string `json:"obj"`
+		Msg     string `json:"msg"`
+	}
+	if err != nil || json.Unmarshal(out, &r) != nil {
+		c.String(502, "بررسی پرداخت انجام نشد. دوباره تلاش کنید یا به پشتیبانی اطلاع دهید.")
+		return
+	}
+	c.Header("Cache-Control", "no-store")
+	if !r.Success {
+		c.String(400, r.Msg)
+		return
+	}
+	c.String(200, r.Obj)
+}
