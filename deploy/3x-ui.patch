+import { useCallback, useEffect, useState } from 'react';
+import { Alert, App, Button, Card, DatePicker, Descriptions, Form, Input, Modal, Popconfirm, Space, Switch, Table, Tag, Typography } from 'antd';
+import dayjs from 'dayjs';
+import { HttpUtil } from '@/utils';
+
+type User = { username: string; enabled: boolean; expired: boolean; expires: number; created: number };
+type Data = { users: User[]; status: { service: string; endpoint: string; online: Record<string, unknown>[] } };
+type Protocol = 'openvpn' | 'openconnect';
+export default function VPNPage({ protocol }: { protocol: Protocol }) {
+ const { message } = App.useApp();
+ const [data,setData]=useState<Data>();
+ const [busy,setBusy]=useState(false);
+ const [error,setError]=useState('');
+ const [editing,setEditing]=useState<User|null|undefined>(undefined);
+ const [form]=Form.useForm();
+ const title=protocol==='openvpn'?'OpenVPN':'OpenConnect';
+ const call=useCallback(async (action: string, values: Record<string,unknown>={}) => {
+   const r=await HttpUtil.post('/panel/api/masiha-vpn',{protocol,action,...values},{headers:{'Content-Type':'application/json'},silent:true,timeout:65000});
+   if(!r?.success) throw new Error(r?.msg || 'عملیات انجام نشد');
+   return r.obj;
+ },[protocol]);
+ const reload=useCallback(async()=>{
+   try {
+    const result=await call('list') as Data;
+    if(!result || !Array.isArray(result.users) || !result.status || !Array.isArray(result.status.online)) throw new Error('پاسخ سرویس معتبر نیست؛ دوباره تلاش کنید');
+    setData(result); setError('');
+   }
+   catch(e) {setError(e instanceof Error?e.message:'خطای ارتباط');}
+ },[call]);
+ useEffect(()=>{setData(undefined);setEditing(undefined);void reload();const t=setInterval(()=>void reload(),15000);return()=>clearInterval(t)},[reload]);
+ const execute=async(action:string,values:Record<string,unknown>)=>{
+   setBusy(true);
+   try {await call(action,values);message.success('انجام شد');await reload();return true;}
+   catch(e){message.error(e instanceof Error?e.message:'خطای عملیات');return false}
+   finally{setBusy(false)}
+ };
+ const edit=(u:User|null)=>{
+   setEditing(u);form.resetFields();
+   form.setFieldsValue({username:u?.username,enabled:u?.enabled??true,expires:u?.expires?dayjs.unix(u.expires):undefined,password:''});
+ };
+ const save=async()=>{
+   try {
+    const v=await form.validateFields();
+    if(await execute(editing?'update':'create',{...v,expires:v.expires?v.expires.unix():0}))setEditing(undefined);
+   }catch{/* Form displays field validation. */}
+ };
+ const download=async(u:User)=>{
+  setBusy(true);
+  try{
+   const r=await call('config',{username:u.username}) as {filename:string;content:string};
+   const url=URL.createObjectURL(new Blob([r.content],{type:'text/plain;charset=utf-8'}));
+   const a=document.createElement('a');a.href=url;a.download=r.filename;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);
+  }catch(e){message.error(e instanceof Error?e.message:'خطای دریافت')}finally{setBusy(false)}
+ };
+ return <div dir="rtl" style={{padding:24}}>
+  <Space orientation="vertical" size="large" style={{width:'100%'}}>
+   <Typography.Title level={2}>{title}</Typography.Title>
+   {error&&<Alert type="error" showIcon title={error} action={<Button onClick={()=>void reload()}>تلاش مجدد</Button>}/>}
+   <Card>
+    <Descriptions items={[
+     {key:'s',label:'وضعیت سرویس',children:<Tag color={data?.status.service==='active'?'green':'red'}>{data?.status.service||'در حال بررسی'}</Tag>},
+     {key:'a',label:'آدرس اتصال',children:<Typography.Text copyable>{data?.status.endpoint}</Typography.Text>},
+     {key:'c',label:'تعداد کاربران',children:data?.users.length??'—'},
+     {key:'o',label:'اتصال‌های آنلاین',children:data?.status.online.length??'—'}
+    ]}/>
+    <Space wrap>
+     <Button type="primary" onClick={()=>edit(null)}>ساخت کاربر</Button>
+     <Button onClick={()=>void reload()}>به‌روزرسانی</Button>
+     <Button disabled={busy||data?.status.service==='active'} onClick={()=>void execute('service',{operation:'start'})}>شروع سرویس</Button>
+     <Popconfirm title="اتصال کاربران این سرویس موقتاً قطع می‌شود. ادامه می‌دهید؟" onConfirm={()=>execute('service',{operation:'restart'})}><Button disabled={busy}>راه‌اندازی مجدد</Button></Popconfirm>
+     <Popconfirm title="سرویس متوقف و کاربران آن قطع شوند؟" onConfirm={()=>execute('service',{operation:'stop'})}><Button danger disabled={busy}>توقف</Button></Popconfirm>
+    </Space>
+   </Card>
+   <Alert type="info" showIcon title={protocol==='openvpn'?'اتصال با فایل اختصاصی .ovpn':'اتصال با برنامه OpenConnect یا AnyConnect'}
+    description={protocol==='openvpn'?'پس از ساخت کاربر، فایل اتصال را دانلود و وارد برنامه OpenVPN کنید. هر فایل شامل کلید خصوصی همان کاربر است. پس از فعال‌سازی دوباره کاربر غیرفعال، فایل جدید دریافت کنید.':'آدرس سرور https://xu.chanelchat.ir:4443 است. نام کاربری و رمز تعیین‌شده را در برنامه وارد کنید. رمز ذخیره‌شده نمایش داده نمی‌شود؛ برای تغییر آن از ویرایش استفاده کنید.'}/>
+   <Table<User> rowKey="username" dataSource={data?.users||[]} loading={!data&&!error} scroll={{x:850}} pagination={{pageSize:10}} columns={[
+    {title:'نام کاربری',dataIndex:'username'},
+    {title:'وضعیت',render:(_,u)=><Tag color={u.enabled&&!u.expired?'green':'red'}>{u.expired?'منقضی':u.enabled?'فعال':'غیرفعال'}</Tag>},
+    {title:'انقضا',render:(_,u)=>u.expires?new Date(u.expires*1000).toLocaleString('fa-IR'):'بدون انقضا'},
+    {title:'عملیات',render:(_,u)=><Space wrap>
+      <Button onClick={()=>edit(u)}>ویرایش / تمدید</Button>
+      <Button disabled={busy||!u.enabled||u.expired} onClick={()=>void download(u)}>{protocol==='openvpn'?'دریافت .ovpn':'اطلاعات اتصال'}</Button>
+      <Popconfirm title="کاربر حذف و اتصال او قطع شود؟" onConfirm={()=>execute('delete',{username:u.username})}><Button danger disabled={busy}>حذف</Button></Popconfirm>
+    </Space>}
+   ]}/>
+   <Typography.Text type="secondary">کاربران این دو سرویس در همین بخش مدیریت می‌شوند. حجم و سابسکریپشن Xray با این حساب‌ها مشترک نیست. انقضا حداکثر ظرف ۱۵ ثانیه اعمال می‌شود.</Typography.Text>
+  </Space>
+  <Modal title={(editing?'ویرایش کاربر ':'ساخت کاربر ')+title} open={editing!==undefined} onCancel={()=>setEditing(undefined)} onOk={()=>void save()} confirmLoading={busy} okText="ذخیره" cancelText="انصراف">
+   <Form form={form} layout="vertical" dir="rtl">
+    <Form.Item label="نام کاربری" name="username" rules={[{required:true,message:'نام کاربری را وارد کنید'},{pattern:/^[a-zA-Z0-9][a-zA-Z0-9_-]{2,39}$/,message:'۳ تا ۴۰ حرف انگلیسی، عدد، خط تیره یا زیرخط'}]}><Input disabled={!!editing} dir="ltr" autoComplete="off"/></Form.Item>
+    {protocol==='openconnect'&&<Form.Item label={editing?'رمز جدید (خالی: بدون تغییر)':'رمز عبور'} name="password" rules={[{required:!editing,message:'رمز عبور الزامی است'},{min:12,message:'حداقل ۱۲ کاراکتر'}]}><Input.Password autoComplete="new-password" dir="ltr"/></Form.Item>}
+    <Form.Item label="تاریخ و ساعت انقضا (خالی: بدون انقضا)" name="expires"><DatePicker showTime style={{width:'100%'}}/></Form.Item>
+    <Form.Item label="فعال" name="enabled" valuePropName="checked"><Switch/></Form.Item>
+   </Form>
+  </Modal>
+ </div>;
+}
