+  {items.map(p=>{
+   const url=base+'/'+p.clientId+'/'+p.protocol;
+   return <Card key={p.clientId+':'+p.protocol} title={p.protocol==='openvpn'?'OpenVPN':'OpenConnect / AnyConnect'} extra={p.label}>
+    {p.protocol==='openconnect' && <Typography.Paragraph><pre dir="ltr" style={{whiteSpace:'pre-wrap',overflowWrap:'anywhere'}}>{p.content}</pre></Typography.Paragraph>}
+    <Space wrap>
+     <Button type="primary" href={url} download={p.filename}>دانلود فایل اتصال</Button>
+     <Button onClick={()=>ClipboardManager.copyText(p.protocol==='openconnect'?p.content:url)}>کپی {p.protocol==='openconnect'?'اطلاعات':'لینک دانلود'}</Button>
