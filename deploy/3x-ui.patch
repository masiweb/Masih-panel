@@ -0,0 +1,33 @@
+package controller
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"github.com/gin-gonic/gin"
+	"net/http"
+	"os/exec"
+	"time"
+)
+
+// This endpoint is registered inside the panel API's authentication, token-scope
+// and CSRF middleware. No shell interpolation or caller-supplied executable.
+func masihaVPN(c *gin.Context) {
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 16384)
+	body, err := c.GetRawData()
+	if err != nil || len(body) > 16384 || !json.Valid(body) {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "msg": "Invalid request"})
+		return
+	}
+	ctx, cancel := context.WithTimeout(c.Request.Context(), 60*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "/usr/bin/python3", "/opt/masiha-vpn-extension/manager.py")
+	cmd.Stdin = bytes.NewReader(body)
+	out, err := cmd.Output()
+	if err != nil || !json.Valid(out) {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "msg": "VPN management operation failed. Check service logs."})
+		return
+	}
+	c.Header("Cache-Control", "no-store")
+	c.Data(http.StatusOK, "application/json; charset=utf-8", out)
+}
