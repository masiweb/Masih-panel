diff --git a/frontend/src/pages/sub/SubVPNProfiles.tsx b/frontend/src/pages/sub/SubVPNProfiles.tsx
new file mode 100644
index 0000000..5181f3d
--- /dev/null
+++ b/frontend/src/pages/sub/SubVPNProfiles.tsx
@@ -0,0 +1,38 @@
+import { useEffect, useState } from 'react';
+import { Alert, Button, Card, Empty, Popover, QRCode, Space, Spin, Typography } from 'antd';
+import { ClipboardManager } from '@/utils';
+type Profile = { protocol: string; clientId: number; label: string; filename: string; content: string; expires: number };
+export default function SubVPNProfiles({ subUrl }: { subUrl: string }) {
+ const [items,setItems]=useState<Profile[]>([]);
+ const [loading,setLoading]=useState(true);
+ const [error,setError]=useState(false);
+ const [attempt,setAttempt]=useState(0);
+ const base=subUrl.replace(/\/$/,'')+'/vpn';
+ useEffect(()=>{
+  const ctrl=new AbortController();setLoading(true);setError(false);
+  fetch(base,{cache:'no-store',signal:ctrl.signal}).then(r=>{if(!r.ok)throw new Error();return r.json();})
+   .then(data=>{if(!Array.isArray(data))throw new Error();setItems(data);})
+   .catch(e=>{if(e.name!=='AbortError')setError(true);}).finally(()=>{if(!ctrl.signal.aborted)setLoading(false);});
+  return ()=>ctrl.abort();
+ },[base,attempt]);
+ if(loading)return <Spin />;
+ if(error)return <Alert type="warning" title="دریافت فایل‌های VPN انجام نشد" action={<Button onClick={()=>setAttempt(n=>n+1)}>تلاش مجدد</Button>} />;
+ if(!items.length)return <Empty description="فایل فعالی موجود نیست؛ ساخت حساب جدید ممکن است چند لحظه زمان ببرد."><Button onClick={()=>setAttempt(n=>n+1)}>تازه‌سازی</Button></Empty>;
+ return <Space orientation="vertical" style={{width:'100%'}}>
