+import json,urllib.request,http.cookiejar,shlex,secrets
+from pathlib import Path
+env={}
+for line in Path('/etc/x-ui/install-result.env').read_text().splitlines():
+ if '=' in line and not line.startswith('#'):
+  k,v=line.split('=',1)
+  env[k]=shlex.split(v)[0] if shlex.split(v) else ''
+base='https://xu.chanelchat.ir/xui'
+client=urllib.request.build_opener(urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))
+def req(path,body=None,token=None):
+ headers={'X-Requested-With':'XMLHttpRequest'}
+ if body is not None:headers['Content-Type']='application/json'
+ if token:headers['X-CSRF-Token']=token
+ with client.open(urllib.request.Request(base+path,data=json.dumps(body).encode() if body is not None else None,headers=headers),timeout=65) as r:
+  return r.read()
+token=json.loads(req('/csrf-token'))['obj']
+assert json.loads(req('/login',{'username':env['XUI_USERNAME'],'password':env['XUI_PASSWORD']},token))['success']
+token=json.loads(req('/panel/csrf-token'))['obj']
+def api(protocol,action,**kw):
+ r=json.loads(req('/panel/api/masiha-vpn',dict(protocol=protocol,action=action,**kw),token))
+ assert r['success'],r.get('msg')
+ return r.get('obj')
+for protocol in ('openvpn','openconnect'):
+ assert api(protocol,'list')['status']['service']=='active'
+ assert b'<html' in req('/panel/'+protocol)
+ user='qa-live-'+secrets.token_hex(4)
+ try:
+  api(protocol,'create',username=user,password=secrets.token_urlsafe(24),enabled=True,expires=0)
+  profile=api(protocol,'config',username=user)
+  assert 'xu.chanelchat.ir' in profile['content']
+  api(protocol,'update',username=user,enabled=False,expires=0)
+ finally:api(protocol,'delete',username=user)
+ print(protocol,'HTTPS authenticated create/export/disable/delete PASS')
+print('Live panel validation PASS')
