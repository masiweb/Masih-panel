[Unit]
Description=Masiha AI image and video job worker
Wants=network-online.target
After=network-online.target masiha-vpn-extension.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/masiha-vpn-extension
ExecStart=/usr/bin/python3 /opt/masiha-vpn-extension/ai_media.py
UMask=0077
Nice=12
CPUQuota=50%
MemoryHigh=600M
MemoryMax=850M
TimeoutStartSec=245
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/masiha-vpn-extension/sales
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
