[Unit]
Description=Masiha IPsec and PPP session traffic accounting
After=strongswan-starter.service xl2tpd.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/masiha-vpn-extension
ExecStart=/usr/bin/python3 /opt/masiha-vpn-extension/ipsec_accounting.py collect
TimeoutStartSec=28
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/x-ui /etc/masiha-vpn-extension /run/masiha-ipsec